{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Ferrin Help",
  "description": "Help for Ferrin, the task app that turns scattered thoughts into a clear plan.",
  "colors": {
    "primary": "#309d4b",
    "light": "#b9dcae",
    "dark": "#237a3a"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#0f0f0f"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Geist"
  },
  "icons": {
    "library": "fontawesome"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "get-started/how-say-it-works"
        ]
      },
      {
        "group": "Capture",
        "pages": [
          "capture/mac",
          "capture/iphone"
        ]
      },
      {
        "group": "Your plan",
        "pages": [
          "plan/review",
          "plan/details",
          "plan/today-and-upcoming",
          "plan/suggestions"
        ]
      },
      {
        "group": "Connect",
        "pages": [
          "connect/ai-agents"
        ]
      },
      {
        "group": "Account and privacy",
        "pages": [
          "account/your-data"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "ferrin.app",
        "href": "https://www.ferrin.app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Try Ferrin",
      "href": "https://www.ferrin.app/#test-drive"
    }
  },
  "seo": {
    "metatags": {
      "canonical": "https://www.ferrin.app/help"
    }
  }
}
